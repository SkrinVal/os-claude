# Vality-Server Konfiguration
# Kopieren nach .env und Pfade an das eigene System anpassen.

# --- Server ---
PORT=4390
# Auf 0.0.0.0 binden, damit die Handy-App im selben Netz erreichen kann
HOST=0.0.0.0

# --- Whisper.cpp (Speech-to-Text) ---
# Pfad zur kompilierten whisper.cpp-Executable, z.B. main.exe / whisper-cli.exe
WHISPER_BIN=C:\\tools\\whisper.cpp\\build\\bin\\Release\\whisper-cli.exe
# Pfad zum GGML-Modell, z.B. ggml-base.bin oder ggml-small.bin
WHISPER_MODEL=C:\\tools\\whisper.cpp\\models\\ggml-base.bin
# Sprache fuer Whisper (de, en, ...) oder "auto"
WHISPER_LANG=de

# --- Claude Code CLI ("Brain") ---
# Meist reicht "claude", falls im PATH. Sonst vollen Pfad angeben.
CLAUDE_BIN=claude
# Zusaetzliche Flags, die an `claude -p` angehaengt werden (optional)
CLAUDE_EXTRA_ARGS=
# Timeout in ms, nach dem ein claude-Aufruf abgebrochen wird
CLAUDE_TIMEOUT_MS=60000

# --- Piper (Text-to-Speech) ---
# Pfad zur piper-Executable
PIPER_BIN=C:\\tools\\piper\\piper.exe
# Pfad zum Stimm-Modell (.onnx) und dessen .json-Konfig
PIPER_MODEL=C:\\tools\\piper\\voices\\de_DE-thorsten-medium.onnx
PIPER_CONFIG=C:\\tools\\piper\\voices\\de_DE-thorsten-medium.onnx.json

# --- Gedaechtnis (Feature 1) ---
# An/aus steht in config/features.json, nicht hier. Diese Werte sind Feintuning.
# Wie viele Interaktionen insgesamt in conversations.json aufgehoben werden.
MEMORY_MAX_CONVERSATION_TURNS=200
# Wie viele der letzten Interaktionen als Kontext in jeden claude -p Aufruf wandern.
MEMORY_CONTEXT_CONVERSATION_TURNS=6
# Wie viele Fakten hoechstens gleichzeitig in den Prompt-Kontext wandern.
MEMORY_CONTEXT_FACTS_LIMIT=20
# Ab wie vielen Monaten ohne Referenz ein Fakt als "stale" markiert wird (nicht geloescht).
MEMORY_STALE_AFTER_MONTHS=6

# --- Anwesenheitserkennung (Feature 2) ---
# An/aus steht in config/features.json. Dieses Token muss exakt mit dem
# Wert uebereinstimmen, den die Handy-App in ihren Einstellungen fuer den
# Server hinterlegt hat. Frei erfinden, z.B. mit `openssl rand -hex 16`.
# Leer lassen = jedes Geraet im Netz kann Events schicken (nur zum Testen).
PRESENCE_TOKEN=
