# Jarvis-Server Konfiguration
# Kopieren nach .env und Pfade an das eigene System anpassen.

# --- Server ---
PORT=4390
# Auf 0.0.0.0 binden, damit die Handy-App im selben Netz erreichen kann
HOST=0.0.0.0

# --- Whisper.cpp (Speech-to-Text) ---
# Pfad zur kompilierten whisper.cpp-Executable, z.B. main.exe / whisper-cli.exe
WHISPER_BIN=C:\\tools\\whisper.cpp\\build\\bin\\Release\\whisper-cli.exe
# Pfad zum GGML-Modell, z.B. ggml-base.bin oder ggml-small.bin
WHISPER_MODEL=C:\\tools\\whisper.cpp\\models\\ggml-base.bin
# Sprache fuer Whisper (de, en, ...) oder "auto"
WHISPER_LANG=de

# --- Claude Code CLI ("Brain") ---
# Meist reicht "claude", falls im PATH. Sonst vollen Pfad angeben.
CLAUDE_BIN=claude
# Zusaetzliche Flags, die an `claude -p` angehaengt werden (optional)
CLAUDE_EXTRA_ARGS=
# Timeout in ms, nach dem ein claude-Aufruf abgebrochen wird
CLAUDE_TIMEOUT_MS=60000

# --- Piper (Text-to-Speech) ---
# Pfad zur piper-Executable
PIPER_BIN=C:\\tools\\piper\\piper.exe
# Pfad zum Stimm-Modell (.onnx) und dessen .json-Konfig
PIPER_MODEL=C:\\tools\\piper\\voices\\de_DE-thorsten-medium.onnx
PIPER_CONFIG=C:\\tools\\piper\\voices\\de_DE-thorsten-medium.onnx.json
